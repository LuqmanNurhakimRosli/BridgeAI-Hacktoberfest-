# OpenRouter Runtime (Used by Gemma 4 26B A4B + OpenRouter / Kokoro TTS)
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_REAL_KEY
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Kokoro TTS Configuration (Uses OPENROUTER_API_KEY automatically, or local backend when merged)
KOKORO_MODEL=kokoro
KOKORO_DEFAULT_VOICE=af_heart
KOKORO_TTS_URL=
KOKORO_API_KEY=

# Teammate's Backend + AI Server URL (When merged locally on your laptop)
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_API_URL=

# App Config
NEXT_PUBLIC_APP_NAME=ASEAN BridgeAI
NEXT_PUBLIC_DEMO_MODE=true
